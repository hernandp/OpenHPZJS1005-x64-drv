#pragma code_page(65001)
#include <winver.h>

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_PRERELEASE | VS_FF_DEBUG
#else
FILEFLAGS VS_FF_PRERELEASE
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE @OPENZJS_FILE_TYPE@
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hernán Di Pietro\0"
            VALUE "FileDescription", "@OPENZJS_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@OPENZJS_VERSION@\0"
            VALUE "InternalName", "@OPENZJS_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@OPENZJS_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "Project Benteveo\0"
            VALUE "ProductVersion", "@OPENZJS_VERSION@\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Hernán Di Pietro and Project Benteveo contributors\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
