; Package-aware Type 3 driver. The generated catalog must be signed before deployment.
[Version]
Signature="$Windows NT$"
Provider=%Provider%
ClassGUID={4D36E979-E325-11CE-BFC1-08002BE10318}
Class=Printer
DriverVer=11/25/2026,0.4.0.0
CatalogFile=lj1005.cat
DriverIsolation=2
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64

[Models.NTamd64]
%Model%=Install,USBPRINT\Hewlett-Packardhp_LaBE8D
%Model%=Install,LPTENUM\Hewlett-Packardhp_LaBE8D

[Install]
CopyFiles=DriverFiles,MonitorFiles,FirmwareFiles
LanguageMonitor="HP LaserJet 1005 Firmware Monitor (Project Benteveo),lj1005monitor.dll"
DataFile=lj1005.gpd
DefaultDataType=RAW
CoreDriverSections="{D20EA372-DD35-4950-9ED8-A6335AFE79F0},UNIDRV.OEM,UNIDRV_DATA,TTFSUB.OEM"

[PrinterPackageInstallation.amd64]
PackageAware=TRUE
CoreDriverDependencies={D20EA372-DD35-4950-9ED8-A6335AFE79F0}

[DriverFiles]
lj1005.gpd
lj1005.ini
lj1005render.dll
lj1005ui.dll

[MonitorFiles]
lj1005monitor.dll,,,0x00000020

[FirmwareFiles]
lj1005-firmware.img,sihp1005.img

[DestinationDirs]
FirmwareFiles=11
DriverFiles=66000
MonitorFiles=66002

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
sihp1005.img=1
lj1005.gpd=1
lj1005.ini=1
lj1005render.dll=1
lj1005ui.dll=1
lj1005monitor.dll=1

[Strings]
Provider="Project Benteveo"
Model="HP Laserjet 1005 (Project Benteveo Driver)"
Disk="HP Laserjet 1005 (Project Benteveo Driver)"
